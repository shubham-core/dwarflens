# Server Environment Variables Configuration
NODE_ENV=production
PORT=3000

# Database Connection (Neon / Postgres)
DATABASE_URL=postgresql://user:password@neon-host:5432/dwarflens?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@neon-host:5432/dwarflens?sslmode=require

# Session Security (Required in production, min 32 characters)
SESSION_SECRET=change-me-to-a-secure-random-string-at-least-32-chars-long

# GitHub OAuth Application Credentials (Required in production)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Domains & URLs (Required in production, no localhost)
APP_URL=https://shubham-core.github.io/dwarflens/
API_URL=https://dwarflens.onrender.com

# Billing & Payment Configuration
# Active provider: stripe | lemonsqueezy | razorpay (default: stripe)
BILLING_PROVIDER=stripe

# Stripe (Required when BILLING_PROVIDER=stripe in production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# Lemon Squeezy (Required when BILLING_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_WEBHOOK_SECRET=

# Razorpay (Required when BILLING_PROVIDER=razorpay)
RAZORPAY_WEBHOOK_SECRET=

# Internal Scheduled Maintenance / Cron Secret (Required in production, min 32 characters)
CRON_SECRET=change-me-to-a-secure-cron-secret-at-least-32-chars-long

# Email Alerts (Optional)
RESEND_API_KEY=re_...
